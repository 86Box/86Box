include_guard(GLOBAL)

set(_native_cpu_source "${CMAKE_CURRENT_LIST_DIR}/../src/arch_detect.c")

function(_native_cpu_probe lang output)
    separate_arguments(compiler_args NATIVE_COMMAND "${CMAKE_${lang}_COMPILER_ARG1}")
    if(lang STREQUAL "CXX")
        set(language c++)
    else()
        set(language c)
    endif()
    execute_process(
        COMMAND "${CMAKE_${lang}_COMPILER}" ${compiler_args} ${ARGN}
                "-###" -E -x "${language}" "${_native_cpu_source}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr
        TIMEOUT 15)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot resolve native ${lang} CPU flags (${result}):\n${stdout}${stderr}")
    endif()
    string(REPLACE "\n" ";" lines "${stdout}${stderr}")
    foreach(line IN LISTS lines)
        separate_arguments(args NATIVE_COMMAND "${line}")
        if("-cc1" IN_LIST args OR line MATCHES "[/\\\\]cc1(plus)?(\\.exe)?[\" ]")
            set(${output} "${args}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Cannot find the ${lang} compiler command in native CPU probe:\n${stdout}${stderr}")
endfunction()

function(_native_cpu_features args output)
    set(features)
    set(is_feature OFF)
    foreach(arg IN LISTS args)
        if(is_feature)
            list(APPEND features "${arg}")
            set(is_feature OFF)
        elseif(arg STREQUAL "-target-feature")
            set(is_feature ON)
        endif()
    endforeach()
    set(${output} "${features}" PARENT_SCOPE)
endfunction()

function(resolve_native_cpu_flags lang output)
    set(flags)
    set(compile_only_flags)
    if(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Optimized native CPU detection requires a native build, not a cross compiler")
    endif()
    if(ARCH STREQUAL "arm64")
        set(native_flags -mcpu=native)
    else()
        set(native_flags -march=native -mtune=native)
    endif()
    _native_cpu_probe("${lang}" native_args ${native_flags})

    if(CMAKE_${lang}_COMPILER_ID STREQUAL "GNU")
        foreach(arg IN LISTS native_args)
            if(arg MATCHES "^-m")
                list(APPEND flags "${arg}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES flags)
    elseif(CMAKE_${lang}_COMPILER_ID MATCHES "Clang|IntelLLVM")
        list(FIND native_args "-target-cpu" index)
        if(index LESS 0)
            message(FATAL_ERROR "Native ${lang} CPU detection did not report a target CPU")
        endif()
        math(EXPR index "${index} + 1")
        list(GET native_args ${index} cpu)
        if(ARCH STREQUAL "arm64")
            set(cpu_flag "-mcpu=${cpu}")
        else()
            set(cpu_flag "-march=${cpu}")
        endif()
        set(flags "${cpu_flag}")
        list(FIND native_args "-tune-cpu" index)
        if(NOT index LESS 0)
            math(EXPR index "${index} + 1")
            list(GET native_args ${index} tune)
            list(APPEND flags "-mtune=${tune}")
        elseif(NOT ARCH STREQUAL "arm64")
            list(APPEND flags "-mtune=${cpu}")
        endif()
        _native_cpu_probe("${lang}" explicit_args ${flags})

        _native_cpu_features("${native_args}" native_features)
        _native_cpu_features("${explicit_args}" explicit_features)
        foreach(feature IN LISTS native_features)
            if(NOT feature IN_LIST explicit_features)
                if(ARCH STREQUAL "arm64")
                    string(SUBSTRING "${feature}" 0 1 sign)
                    string(SUBSTRING "${feature}" 1 -1 name)
                    if(sign STREQUAL "-")
                        set(name "no${name}")
                    endif()
                    string(APPEND cpu_flag "+${name}")
                else()
                    list(APPEND compile_only_flags -Xclang -target-feature -Xclang "${feature}")
                endif()
            endif()
        endforeach()
        if(ARCH STREQUAL "arm64")
            list(REMOVE_AT flags 0)
            list(PREPEND flags "${cpu_flag}")
        endif()

        # A named CPU alone can omit extensions detected by "native".
        _native_cpu_probe("${lang}" resolved_args ${flags} ${compile_only_flags})
        _native_cpu_features("${resolved_args}" resolved_features)
        list(SORT native_features)
        list(SORT resolved_features)
        if(NOT native_features STREQUAL resolved_features)
            message(FATAL_ERROR "Explicit ${lang} CPU flags do not preserve native features: ${flags}")
        endif()
    else()
        message(FATAL_ERROR "Native CPU detection is not supported for ${CMAKE_${lang}_COMPILER_ID}")
    endif()

    if(NOT "${flags}" MATCHES "(^|;)-m(arch|cpu)=" OR "${flags}" MATCHES "=native($|;)")
        message(FATAL_ERROR "The ${lang} compiler did not resolve native CPU flags: ${flags}")
    endif()
    message(STATUS "Optimized ${lang} CPU flags: ${flags}")
    set(${output} "${flags}" PARENT_SCOPE)
    set(${output}_COMPILE_ONLY "${compile_only_flags}" PARENT_SCOPE)
endfunction()

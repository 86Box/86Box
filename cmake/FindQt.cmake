if(QT6_FORCE_DYNAMIC)
    set(QT_STATIC OFF)
else()
    set(QT_STATIC ${STATIC_BUILD})
endif()

if(USE_QT6)
    set(_qt_candidates 6)
else()
    set(_qt_candidates 5 6)
endif()

set(_qt_prefix_path "${CMAKE_PREFIX_PATH}")
set(_qt_prefer_config "${CMAKE_FIND_PACKAGE_PREFER_CONFIG}")
# Avoid repeated Harfbuzz config loading with MinGW Qt6.
set(CMAKE_FIND_PACKAGE_PREFER_CONFIG OFF)
find_package(Threads REQUIRED)

set(_qt_errors "")
unset(QT_MAJOR)
foreach(_qt_major IN LISTS _qt_candidates)
    if(APPLE)
        set(CMAKE_FIND_FRAMEWORK LAST)
        if(_qt_major EQUAL 6)
            set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15")
        elseif(MOLTENVK)
            set(CMAKE_OSX_DEPLOYMENT_TARGET "10.14")
        else()
            set(CMAKE_OSX_DEPLOYMENT_TARGET "10.13")
        endif()
    endif()

    if(QT_STATIC AND MINGW)
        set(CMAKE_PREFIX_PATH "$ENV{MSYSTEM_PREFIX}/qt${_qt_major}-static")
    endif()

    if(VCPKG_TOOLCHAIN AND VCPKG_USE_HOST_TOOLS)
        set(QT_HOST_PATH "${VCPKG_INSTALLED_DIR}/${VCPKG_HOST_TRIPLET}/tools/Qt${_qt_major}")
        set(QT_HOST_PATH_CMAKE_DIR "${VCPKG_INSTALLED_DIR}/${VCPKG_HOST_TRIPLET}")
        set(Qt${_qt_major}LinguistTools_ROOT "${QT_HOST_PATH_CMAKE_DIR}")
    endif()

    find_package(Qt${_qt_major} QUIET COMPONENTS Core Widgets Network OpenGL Gui)
    find_package(Qt${_qt_major}LinguistTools QUIET NO_CMAKE_FIND_ROOT_PATH)
    if(Qt${_qt_major}_FOUND AND Qt${_qt_major}LinguistTools_FOUND)
        set(QT_MAJOR ${_qt_major})
        break()
    endif()

    if(NOT Qt${_qt_major}_FOUND)
        string(APPEND _qt_errors "\n  Qt${_qt_major}: requires Core, Widgets, Network, OpenGL and Gui. ${Qt${_qt_major}_NOT_FOUND_MESSAGE}")
    endif()
    if(NOT Qt${_qt_major}LinguistTools_FOUND)
        string(APPEND _qt_errors "\n  Qt${_qt_major}: requires LinguistTools. ${Qt${_qt_major}LinguistTools_NOT_FOUND_MESSAGE}")
    endif()
endforeach()

set(CMAKE_PREFIX_PATH "${_qt_prefix_path}")
set(CMAKE_FIND_PACKAGE_PREFER_CONFIG "${_qt_prefer_config}")

if(NOT DEFINED QT_MAJOR)
    message(FATAL_ERROR "No usable Qt installation found (searched Qt versions: ${_qt_candidates}).${_qt_errors}\nInstall the matching Qt development packages and LinguistTools, or set CMAKE_PREFIX_PATH to their installation prefix.")
endif()

# Keep the detected version out of the cache so automatic selection stays automatic.
if(QT_MAJOR EQUAL 6)
    set(USE_QT6 ON)
else()
    set(USE_QT6 OFF)
endif()
message(STATUS "Found Qt${QT_MAJOR}")
